rhythm.med.uoc.gr {
	encode zstd gzip

	# Applied to every response — including static/media served directly by
	# Caddy below, which never passes through Django's SecurityMiddleware.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# fonts.googleapis.com allowed for CODE (/code); harmless for the CT upload app on /
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'; connect-src 'self'"
		-Server
	}

	redir /code /code/ 308

	handle /code/* {
		reverse_proxy code_frontend:80
	}

	@static path /static/*
	handle @static {
		# Filenames are content-hashed by Django's ManifestStaticFilesStorage
		# (e.g. examination_entry.a1b2c3d4.js), so a changed file is always a
		# new URL — safe to cache aggressively and permanently here.
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	@media path /media/*
	handle @media {
		root * /srv
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
