# Edge reverse proxy on backup-rhythm (147.52.71.226).
#
# Public names that resolve here:
#   rhythm.med.uoc.gr              — primary hub (upload + tools + CODE)
#   ctdose-iqurad.med.uoc.gr       — A record
#   medphys-tools.med.uoc.gr       — CNAME → ctdose-iqurad
#   idose.med.uoc.gr               — CNAME → ctdose-iqurad
#   embryodose.med.uoc.gr          — A record (CODE / conceptus dose)

(edge_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# fonts.googleapis.com allowed for CODE (/code); harmless elsewhere.
		# "?" = default only: routes below may set their own CSP.
		?Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'; connect-src 'self'"
		-Server
	}
}

# Upgraded medphys tools (Django 5.2) — jQuery/Bootstrap CDNs, inline scripts, reCAPTCHA.
(medphys_csp) {
	header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://code.jquery.com https://cdnjs.cloudflare.com https://stackpath.bootstrapcdn.com https://maxcdn.bootstrapcdn.com https://cdn.jsdelivr.net https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://code.jquery.com https://cdnjs.cloudflare.com https://stackpath.bootstrapcdn.com https://maxcdn.bootstrapcdn.com https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://maxcdn.bootstrapcdn.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob: https:; frame-src https://www.google.com; connect-src 'self'"
}

(medphys_apps) {
	redir /ctrad /ctrad/ 308
	handle /ctrad/* {
		import medphys_csp
		reverse_proxy medphys_ctrad:8000
	}

	redir /xsg /xsg/ 308
	handle /xsg/* {
		import medphys_csp
		reverse_proxy medphys_xsg:8000
	}

	redir /autowed /autowed/ 308
	handle /autowed/* {
		import medphys_csp
		reverse_proxy medphys_autowed:8000
	}

	redir /idose /idose/ 308
	handle_path /idose/* {
		import medphys_csp
		# idose is a root-mounted app: strip /idose, Django adds it back (FORCE_SCRIPT_NAME).
		reverse_proxy medphys_idose:8000
	}
}

(code_app) {
	redir /code /code/ 308
	handle /code/* {
		reverse_proxy code_frontend:80
	}
}

# ---------------------------------------------------------------------------
# Primary hub
# ---------------------------------------------------------------------------
rhythm.med.uoc.gr {
	encode zstd gzip
	import edge_headers
	import code_app
	import medphys_apps

	@static path /static/*
	handle @static {
		# Filenames are content-hashed by Django's ManifestStaticFilesStorage
		# (e.g. examination_entry.a1b2c3d4.js), so a changed file is always a
		# new URL — safe to cache aggressively and permanently here.
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	# /media/ holds partner study-set ZIPs (CT images). They are downloaded
	# only through Django's login- and institution-checked views, so never
	# serve this directory directly, and never pass it to Django either.
	@media path /media /media/*
	handle @media {
		respond 404
	}

	handle {
		reverse_proxy web:8000
	}
}

# ---------------------------------------------------------------------------
# Legacy medphys hostnames (DNS → this server)
# ---------------------------------------------------------------------------
ctdose-iqurad.med.uoc.gr, medphys-tools.med.uoc.gr {
	encode zstd gzip
	import edge_headers
	import medphys_apps

	# Unknown paths → primary hub (preserves URI).
	handle {
		redir https://rhythm.med.uoc.gr{uri} 308
	}
}

# idose.med.uoc.gr is a CNAME of ctdose-iqurad; Host header stays "idose…".
# App is path-mounted at /idose (FORCE_SCRIPT_NAME=/idose).
idose.med.uoc.gr {
	encode zstd gzip
	import edge_headers

	redir / /idose/ 308
	redir /idose /idose/ 308
	handle_path /idose/* {
		import medphys_csp
		reverse_proxy medphys_idose:8000
	}
}

# ---------------------------------------------------------------------------
# CODE (conceptus dose) — historically embryodose.med.uoc.gr/code
# ---------------------------------------------------------------------------
embryodose.med.uoc.gr {
	encode zstd gzip
	import edge_headers

	redir / /code/ 308
	import code_app
}
