# Django Configuration
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Security: IP Whitelist Configuration
# Restrict access to specified IPs or CIDR ranges (comma-separated)
# Example: "192.168.1.1,10.0.0.0/8,127.0.0.1"
# Leave empty to allow all IPs
IP_WHITELIST=

# Database Configuration (PostgreSQL)
DB_NAME=ct_upload_platform
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Email Configuration for User Account Notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@ct-upload-platform.local

# Orthanc DICOM Server Configuration
# Orthanc is the authoritative DICOM storage.
# Django pushes de-identified DICOM files to Orthanc via STOW-RS.
ORTHANC_BASE_URL=http://orthanc:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc

# S3 / Django Storages Configuration
USE_S3=False
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=private
AWS_S3_SIGNATURE_VERSION=s3v4

# Custom Application Settings
MAX_UPLOAD_SIZE_MB=2048
MAX_IMAGES_PER_UPLOAD=10000
DICOM_ENRICHMENT_ENABLED=True
PHI_STRIP_TAGS=PatientName,PatientID,PatientBirthDate,PatientAge,PatientSex,InstitutionName,ReferringPhysicianName,StudyID,AccessionNumber
MANIFEST_SCHEMA_VERSION=1.0
UPLOAD_TOKEN_EXPIRY_DAYS=90
TOKEN_EXPIRY_DAYS=30
